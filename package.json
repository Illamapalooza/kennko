{
  "name": "kennko",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "npm run dev -w @kennko/web",
    "build": "npm run build -w @kennko/web",
    "pos": "npm run dev -w @kennko/pos",
    "pos:build": "npm run build -w @kennko/pos",
    "pos:start": "npm start -w @kennko/pos",
    "wall": "node wall/server.mjs",
    "test": "npm test --workspaces --if-present && node --test wall/test/*.test.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
