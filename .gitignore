.vercel

# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage

# next.js
.next/
out/

# production
build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# keep the documented env template committed
!.env.local.example

# supabase CLI link state
/apps/api/supabase/.temp/
/apps/web/supabase/.temp/

# playwright mcp scratch output
.playwright-mcp/

# cat cafe wall: the day's orders and the shop's own music stay off git
/wall/data/
/wall/music/*
!/wall/music/.gitkeep

# POS: the shop's sales database, its own settings, and the built screens stay off git
/apps/pos/data/
/apps/pos/config.json
/apps/pos/dist/

# Built API bundle (apps/api npm run build)
/apps/api/server.js

# Android apps & signing
/apps/pos/dist-app/
/apps/wall-app/www/
/apps/wall-app/www-probe/scene/
/apps/*/android/app/release/
*.apk
*.aab
*.jks
*.keystore
keystore.properties
