# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Local scripts only (npm run seed, seed-zones, create-owner); never set it on Vercel. The website itself
# never uses it: every privileged read or write goes through the API. Never commit it -- it bypasses row
# level security.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Online ordering (/order and the API). The checkout shows the shop's GCash QR from public/gcash-qr.png.
# Set to "true" to open it.
NEXT_PUBLIC_ORDERING_ENABLED=false

# Optional. Without it, emails are logged instead of sent -- a missing key
# must never lose a paid order.
RESEND_API_KEY=
ORDER_EMAIL_FROM=Kennko Coffee <orders@yourdomain.com>

# Base URL of the Kennko API (apps/api), server-side only, e.g. https://api.kennko.example
# The website reads the published menu from ${KENNKO_API_URL}/v1/menu. Optional: when
# unset, a warning is logged and the menu renders empty.
KENNKO_API_URL=

# Shared secret for the checkout's staff alert list (GET /v1/staff/alert-emails). Must equal the API's
# KENNKO_WEB_KEY (at least 32 characters, e.g. `openssl rand -hex 32`). Server-side only. When unset, the
# new-order staff alert is skipped with a log line; checkout is unaffected.
KENNKO_WEB_KEY=

# Web Push public key (the VAPID public key from the API's setup). The notify and order-alert buttons stay
# hidden without it. Safe to expose to the browser; the private key lives only in the API.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
