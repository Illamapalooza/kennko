# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Required only to run `npm run seed`. Never commit this and never expose it
# to the browser -- it bypasses row level security.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Ordering stays off until the real GCash QR replaces the placeholder in
# public/gcash-qr-placeholder.png. Set to "true" to open /order and the API.
NEXT_PUBLIC_ORDERING_ENABLED=false

# Optional. Without it, emails are logged instead of sent -- a missing key
# must never lose a paid order.
RESEND_API_KEY=
ORDER_EMAIL_FROM=Kennko Coffee <orders@yourdomain.com>

# Base URL of the Kennko API (apps/api), server-side only, e.g. https://api.kennko.example
# The website reads the published menu from ${KENNKO_API_URL}/v1/menu. Optional: when
# unset, a warning is logged and the menu renders empty.
KENNKO_API_URL=

# Web Push public key (the VAPID public key from the API's setup). The notify and order-alert buttons stay
# hidden without it. Safe to expose to the browser; the private key lives only in the API.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
